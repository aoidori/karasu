<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%t] %logger{36} [k8s=%X{k8s_cluster} kafka=%X{kafka_cluster} gen=%X{gen}] - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="org.apache.kafka" level="WARN"/>
        <Logger name="io.karasu" level="INFO"/>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
